# ==============================================================================
# FORECAST SYSTEM — ENVIRONMENT TEMPLATE
# ==============================================================================
# HƯỚNG DẪN:
#   1. cp .env.example config/.env
#   2. Điền giá trị thật vào config/.env
#   3. KHÔNG BAO GIỜ commit config/.env  (đã có trong .gitignore)
#
# File này CHỈ chứa placeholder. Mọi giá trị thật phải nằm ngoài git.
# Ở production nên dùng secret manager (Vault / AWS Secrets Manager /
# Azure Key Vault / Kubernetes Secret) thay vì file .env trên đĩa.
# ==============================================================================

# ------------------------------------------------------------------------------
# RUNTIME
# ------------------------------------------------------------------------------
# dev | staging | production
APP_ENV=dev
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# DATABASE  (BẮT BUỘC — không có default, thiếu sẽ ConfigurationError)
# ------------------------------------------------------------------------------
# Tài khoản nên là READ-ONLY, chỉ cấp quyền SELECT trên đúng schema cần thiết.
DB_DRIVER=mysql+pymysql
DB_HOST=<datamart-host.internal.example.com>
DB_PORT=<3306>
DB_NAME=<database_name>
DB_USER=<readonly_service_account>
DB_PASSWORD=<đặt-tại-đây-hoặc-inject-từ-secret-manager>

# ------------------------------------------------------------------------------
# LLM / LM STUDIO
# ------------------------------------------------------------------------------
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=<api-key-nếu-endpoint-yêu-cầu>
LM_STUDIO_MODEL=openai/gpt-oss-20b
LM_STUDIO_TIMEOUT=120
LM_STUDIO_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# DASHBOARD / API SECURITY
# ------------------------------------------------------------------------------
# Sinh key: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_API_KEY=<sinh-bằng-lệnh-ở-trên>
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5050
DASHBOARD_DEBUG=false
# Danh sách origin cho CORS, phân tách bằng dấu phẩy. Rỗng = chặn cross-origin.
DASHBOARD_CORS_ORIGINS=

# ------------------------------------------------------------------------------
# FORECAST PARAMETERS  (có default hợp lý, override khi cần)
# ------------------------------------------------------------------------------
FORECAST_MONTHS_AHEAD=3
DAILY_FORECAST_DAYS=30
SHORT_HORIZON_DAYS=30
INACTIVE_THRESHOLD=30
AI_INFERENCE_THRESHOLD=0.50
AI_TIMEOUT_PER_RESTAURANT=300

# Chỉ dùng khi backtest/replay — ép ngày "hôm nay" của hệ thống (ISO: YYYY-MM-DD)
# FORECAST_CURRENT_DATE=

# ------------------------------------------------------------------------------
# MODEL WEIGHTS
# ------------------------------------------------------------------------------
META_LEARNER_ENABLED=true
ML_STACKING_SHARE=0.60
NP_SHARE=0.20
PROPHET_SHARE=0.20
